# Copy to .env (or set in your process manager). Never commit real values.
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=school.example.ug
CSRF_TRUSTED_ORIGINS=https://school.example.ug
CORS_ALLOWED_ORIGINS=https://school.example.ug
PUBLIC_BASE_URL=https://school.example.ug

DB_ENGINE=postgres
DB_NAME=sms
DB_USER=sms_app
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@school.example.ug
